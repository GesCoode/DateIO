{
  "_meta": {
    "title": "Visagely · vast.ai 24GB · FLUX LoRA + Union ControlNet (pose)",
    "description": "Product generation path. Requires InstantX/Shakker Union ControlNet, controlnet_aux, and your identity LoRA. SetUnionControlNetType pose = OpenPose. Strength 0.65, end_percent 0.6. Swap preprocessor to depth and type to depth for placement maps."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev-fp8.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "4": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["2", 0],
      "lora_name": "vsgly_id_v1.safetensors",
      "strength_model": 0.9,
      "strength_clip": 0.9
    }
  },
  "5": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "flux1-dev-controlnet-union.safetensors"
    }
  },
  "6": {
    "class_type": "SetUnionControlNetType",
    "inputs": {
      "control_net": ["5", 0],
      "type": "openpose"
    }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "pose_reference.png"
    }
  },
  "8": {
    "class_type": "AIO_Preprocessor",
    "inputs": {
      "image": ["7", 0],
      "preprocessor": "OpenposePreprocessor"
    }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 1],
      "text": "vsgly_id, candid full-body photo, smart casual linen shirt, walking mid-stride on a sunlit sandy beach at golden hour, warm backlight, natural skin texture, photorealistic"
    }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 1],
      "text": "plastic skin, extra fingers, deformed hands, warped face, cartoon, cgi, watermark"
    }
  },
  "11": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["9", 0],
      "guidance": 3.5
    }
  },
  "12": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["11", 0],
      "negative": ["10", 0],
      "control_net": ["6", 0],
      "image": ["8", 0],
      "strength": 0.65,
      "start_percent": 0,
      "end_percent": 0.6
    }
  },
  "13": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 768,
      "height": 1024,
      "batch_size": 1
    }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["13", 0],
      "seed": 42,
      "steps": 28,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["14", 0],
      "vae": ["3", 0]
    }
  },
  "16": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["15", 0],
      "filename_prefix": "visagely_vast_cn"
    }
  }
}
