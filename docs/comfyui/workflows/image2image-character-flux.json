{
  "_meta": {
    "title": "Visagely · Image2Image character pipeline (FLUX)",
    "description": "Recreates the screenshot graph with vanilla Comfy nodes. Load a scene in Image To Copy, keep denoise ~0.53 so pose/lighting hold, put the LoRA trigger first in the prompt. The character reference image is visual-only; identity comes from the LoRA. Get_CLIP / Get_VAE / Get_Model / Pre-Sampling in the original are Easy-Use-style pipe nodes — this file is the same wiring without that pack."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev-fp8.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "4": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["2", 0],
      "lora_name": "vsgly_id_flux_v1.safetensors",
      "strength_model": 0.9,
      "strength_clip": 0.9
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "character_reference.png"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "image_to_copy.png"
    }
  },
  "7": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["6", 0],
      "upscale_method": "lanczos",
      "width": 1136,
      "height": 2032,
      "crop": "disabled"
    }
  },
  "8": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["7", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 1],
      "text": "vsgly_id, photorealistic photo of a woman standing on a cobblestone street at night, rust-orange long-sleeve mini dress, hand on hip, looking at camera, warm street lights, full body"
    }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 1],
      "text": "plastic skin, extra fingers, deformed hands, warped face, cartoon, cgi, watermark"
    }
  },
  "11": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["9", 0],
      "guidance": 3.5
    }
  },
  "12": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["11", 0],
      "negative": ["10", 0],
      "latent_image": ["8", 0],
      "seed": 370104869846578,
      "steps": 20,
      "cfg": 1,
      "sampler_name": "euler_ancestral",
      "scheduler": "beta",
      "denoise": 0.53
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["3", 0]
    }
  },
  "14": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": ["13", 0]
    }
  },
  "15": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["13", 0],
      "filename_prefix": "visagely_i2i"
    }
  }
}
